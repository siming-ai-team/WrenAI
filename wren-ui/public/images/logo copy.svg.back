<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 256 256">
  <defs>
    <linearGradient id="wingGrad" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0%" stop-color="#3B82F6"></stop>
      <stop offset="100%" stop-color="#06B6D4"></stop>
    </linearGradient>
    <linearGradient id="irisGrad" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0%" stop-color="#60A5FA"></stop>
      <stop offset="100%" stop-color="#22D3EE"></stop>
    </linearGradient>
  </defs>

  <!-- Owl silhouette -->
  <g fill="#0F172A">
    <!-- Ear tufts -->
    <polygon points="92,32 76,62 108,54"></polygon>
    <polygon points="164,32 148,54 180,62"></polygon>
    <!-- Body -->
    <path d="M128 232 C104 212 56 172 56 110 C56 74 88 44 128 44 C168 44 200 74 200 110 C200 172 152 212 128 232 Z"></path>
  </g>

  <!-- Eyes -->
  <circle cx="102" cy="100" r="22" fill="#FFFFFF"></circle>
  <circle cx="154" cy="100" r="22" fill="#FFFFFF"></circle>
  <circle cx="102" cy="100" r="12" fill="url(#irisGrad)"></circle>
  <circle cx="154" cy="100" r="12" fill="url(#irisGrad)"></circle>
  <circle cx="102" cy="100" r="6" fill="#0B1020"></circle>
  <circle cx="154" cy="100" r="6" fill="#0B1020"></circle>
  <circle cx="97" cy="96" r="3" fill="#FFFFFF" opacity="0.85"></circle>
  <circle cx="149" cy="96" r="3" fill="#FFFFFF" opacity="0.85"></circle>

  <!-- Beak -->
  <rect x="124" y="118" width="8" height="8" rx="1" fill="#F59E0B" transform="rotate(45 128 122)"></rect>

  <!-- Chest data bars (insight motif) -->
  <rect x="92" y="148" width="18" height="40" rx="9" fill="url(#wingGrad)"></rect>
  <rect x="119" y="136" width="18" height="56" rx="9" fill="url(#wingGrad)"></rect>
  <rect x="146" y="154" width="18" height="32" rx="9" fill="url(#wingGrad)"></rect>

  <!-- Small spark (idea) -->
  <path d="M128 18 l4 8 8 4 -8 4 -4 8 -4 -8 -8 -4 8 -4z" fill="#F59E0B" opacity="0.9"></path>
</svg>
